# ---------------------------------------------------------------------------
# Copy to .env at the repository root. The API loads this file via dotenv-cli.
# ---------------------------------------------------------------------------

# API
SERVER_PORT=3333

# PostgreSQL (matches docker-compose.yml)
DATABASE_URL="postgresql://docker:docker@localhost:5432/next-saas?schema=public"

# JWT signing secret — use a long random value in any real environment
JWT_SECRET="replace-with-a-long-random-secret"

# GitHub OAuth App
# Callback URL configured in GitHub must match this value:
#   http://localhost:3000/api/auth/callback
GITHUB_OAUTH_CLIENT_ID="your-github-oauth-client-id"
GITHUB_OAUTH_CLIENT_SECRET="your-github-oauth-client-secret"
GITHUB_OAUTH_CLIENT_REDIRECT_URI="http://localhost:3000/api/auth/callback"
